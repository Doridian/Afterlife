{
  "version": 6,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native (Linux / macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "debug",
      "displayName": "Native debug + sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (configure via: emcmake cmake --preset wasm)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "wasm", "configurePreset": "wasm" }
  ]
}
