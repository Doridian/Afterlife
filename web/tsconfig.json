{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "noEmitOnError": true,
    "useDefineForClassFields": false,
    "rootDir": ".",
    "outDir": "../build/web-js"
  },
  "files": ["emscripten.d.ts", "iso9660.ts", "zip.ts", "audio.ts", "pre.ts"]
}
